# Set a long, random secret before deployment. Never commit your .env file.
SECRET_KEY=replace-with-a-long-random-secret
PORT=5000
HOST=127.0.0.1
DATABASE_PATH=boilerbuddies.sqlite3

# Optional local AI through Ollama
GEMMA_MODEL=gemma3:4b
OLLAMA_URL=http://localhost:11434/api/chat

# Set to 1 only when served over HTTPS
COOKIE_SECURE=0
